---
import { ClientRouter } from "astro:transitions";
import "@pages/_main.ts";
import "@assets/css/global.css";
import { getLangFromUrl, useTranslations } from "@src/i18n";
import TerminalLogo from "../../terminal-logo";
import NavLinks from "../../nav-links";
import NeuroPlayer from "../../neuro-player";
import SystemStats from "../../system-stats";
import TechThemeSwitcher from "@components/extras/tech-theme-switcher";
import LanguageSwitcher from "@components/extras/language-switcher";
import FloatingActionChat from "../../floating-action-chat";
import ProtostarOverlay from "../../special/protostar-overlay";
import NatureOverlay from "../../special/nature-overlay";
import AI_AssistantButton from "../../ai-assistant-button";
import PlanetOverlay from "../../special/planet-overlay";
import MobileHeader from "./mobile-header";
import MobileToolsDock from "./mobile-tools-dock";
import * as env from "astro:env/server";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("metadata.home.title"),
  description = t("metadata.home.description"),
  translations,
} = Astro.props;

// Cookie-based Theme Persistence (SSR to prevent FOUC)
const themeColorCookie = Astro.cookies.get("theme-color")?.value;
const defaultThemeColor = "#306998"; // Python Blue (default)
const activeThemeColor = themeColorCookie || defaultThemeColor;

function hexToRgb(hex: string): string {
  // Expand shorthand form (e.g. "03F") to full form (e.g. "0033FF")
  const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
  const fullHex = hex.replace(shorthandRegex, (_m, r, g, b) => {
    return r + r + g + g + b + b;
  });

  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(fullHex);
  return result
    ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}`
    : "48, 105, 152"; // Default fallback
}

const activeThemeRgb = hexToRgb(activeThemeColor);
---

<!doctype html>
<html
  lang={lang}
  class="dark"
  style={`--primary: ${activeThemeColor}; --primary-rgb: ${activeThemeRgb};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/vigilio.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script
      define:vars={{
        STORAGE_CDN_URL: env.STORAGE_CDN_URL,
        NAME_APP: env.NAME_APP,
        VAPID_PUBLIC_KEY: env.VAPID_PUBLIC_KEY,
        NODE_ENV: env.NODE_ENV?.toUpperCase(),
        PUBLIC_URL: env.PUBLIC_URL,
      }}
      is:inline
    >
      window.env = {
        STORAGE_CDN_URL,
        NAME_APP,
        VAPID_PUBLIC_KEY,
        NODE_ENV,
        PUBLIC_URL,
      };
    </script>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      html,
      body {
        height: 100%;
        overflow: hidden;
      }
      /* Removed fixed flex-direction: row; handled by tailwind classes */

      @keyframes whatsapp-shimmer {
        0%   { background-position: -200% center; }
        100% { background-position: 200% center; }
      }
    </style>
  </head>
  <body
    class="bg-background text-foreground antialiased selection:bg-primary/30 selection:text-primary-foreground h-dvh w-full flex flex-col md:flex-row overflow-hidden fixed inset-0"
  >
    {/* Background Grid Accent */}
    <div
      class="fixed inset-0 bg-[url('/grid.svg')] opacity-[0.03] pointer-events-none -z-20"
    >
    </div>

    {/* MOBILE HEADER */}
    <MobileHeader lang={lang} STORAGE_CDN_URL={env.STORAGE_CDN_URL} client:load />
    <MobileToolsDock
      lang={lang}
      client:load
      STORAGE_CDN_URL={env.STORAGE_CDN_URL}
    />

    {/* LEFT SIDEBAR (Desktop) */}
    <aside
      class="hidden xl:flex w-64 border-r border-white/5 bg-black/40 backdrop-blur-xl flex-col shrink-0 z-40 relative group"
    >
      <div class="h-24 flex items-center px-6">
        <a href={`/${lang}`} class="flex items-center gap-4 group">
          <img
            src="/images/vigilio.png"
            alt="Vigilio Logo"
            class="w-16 h-16 object-contain group-hover:scale-105 transition-transform"
          />
          <div class="flex flex-col justify-center">
            <span
              class="text-base font-black tracking-widest text-white leading-none"
              >YONATAN</span
            >
            <span
              class="text-xs font-bold tracking-[0.2em] text-muted-foreground leading-none mt-1"
              >VIGILIO</span
            >
          </div>
        </a>
      </div>

      <nav class="flex-1 overflow-y-auto px-2 py-4 thin-scrollbar">
        <NavLinks lang={lang} vertical client:load />
      </nav>

      {/* Decorative Sidebar Info */}

      <div class="border-t border-white/5 bg-zinc-950/20">
        <NeuroPlayer
          client:only="preact"
          transition:persist
          STORAGE_CDN_URL={env.STORAGE_CDN_URL}
        />
      </div>

      <div
        class="p-4 border-t border-white/5 bg-zinc-900/40 flex flex-col gap-4"
      >
        {/* Controls Area */}
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <LanguageSwitcher translations={translations} client:load />
          </div>
          <div>
            <TechThemeSwitcher initialColor={activeThemeColor} client:load />
          </div>
        </div>
      </div>
    </aside>

    {/* MAIN CONTENT AREA */}
    <main class="flex-1 relative flex flex-col overflow-hidden w-full">
      {/* Dynamic Scanline Overlay */}
      <div
        class="absolute inset-0 bg-scanline opacity-[0.03] pointer-events-none z-10"
      >
      </div>

      <div
        class="flex-1 overflow-y-auto relative scroll-smooth thin-scrollbar custom-scrollbar"
      >
        <slot />

        {
          /* Mobile Footer Spacing if needed, or Mobile Music Player placeholder */
        }
        <div class="h-20 5xl:hidden block"></div>
      </div>

      <div class="md:hidden fixed bottom-0 left-0 right-0 z-45 w-full"></div>
    </main>

    {/* RIGHT SIDEBAR (Desktop) */}
    <aside
      class="hidden xl:flex w-80 border-l border-white/5 bg-black/40 backdrop-blur-xl flex-col shrink-0 z-40"
    >
      <div
        class="h-20 flex items-center justify-between px-6 border-b border-white/5"
      >
        <div class="flex flex-col">
          <span
            class="text-[8px] text-muted-foreground uppercase tracking-[0.3em]"
            >{t("layout.location")}</span
          >
          <span class="text-[10px] text-foreground font-mono"
            >NEO_TOKYO_SERVER_04</span
          >
        </div>
        <div class="flex flex-col items-end">
          <span
            class="text-[8px] text-muted-foreground uppercase tracking-[0.3em]"
            >{t("layout.encryption")}</span
          >
          <span class="text-[10px] text-primary font-mono">AES-256-GCM</span>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-6 thin-scrollbar">
        <SystemStats lang={lang} client:load transition:persist />

        <div class="space-y-2">
          {/* Quick Stats Cards */}
          <div
            class="p-4 border border-white/5 bg-primary/5 rounded-sm hover:bg-primary/10 transition-colors group"
          >
            <div class="flex items-center gap-3 mb-2">
              <div
                class="p-1.5 bg-primary/20 rounded-sm text-primary group-hover:scale-110 transition-transform"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
                  ></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
                    x1="12"
                    y1="17"
                    x2="12"
                    y2="21"></line></svg
                >
              </div>
              <span
                class="text-[11px] font-bold tracking-widest text-foreground"
                >{t("layout.scalability")}</span
              >
            </div>
            <p
              class="text-[9px] text-muted-foreground/80 leading-relaxed uppercase tracking-widest"
            >
              Docker Swarm / Distributed
            </p>
          </div>

          <div
            class="p-4 border border-white/5 bg-zinc-900/40 rounded-sm hover:bg-zinc-900/60 transition-colors group"
          >
            <div class="flex items-center gap-3 mb-2">
              <div
                class="p-1.5 bg-indigo-500/20 rounded-sm text-indigo-400 group-hover:scale-110 transition-transform"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  ></path></svg
                >
              </div>
              <span
                class="text-[11px] font-bold tracking-widest text-foreground"
                >{t("layout.security")}</span
              >
            </div>
            <p
              class="text-[9px] text-muted-foreground/80 leading-relaxed uppercase tracking-widest"
            >
              Zero-Trust / OAuth2
            </p>
          </div>

          <div
            class="p-4 border border-white/5 bg-zinc-900/40 rounded-sm hover:bg-zinc-900/60 transition-colors group"
          >
            <div class="flex items-center gap-3 mb-2">
              <div
                class="p-1.5 bg-emerald-500/20 rounded-sm text-emerald-400 group-hover:scale-110 transition-transform"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
                >
              </div>
              <span
                class="text-[11px] font-bold tracking-widest text-foreground"
                >{t("layout.performance")}</span
              >
            </div>
            <p
              class="text-[9px] text-muted-foreground/80 leading-relaxed uppercase tracking-widest"
            >
              WASM / WebGL
            </p>
          </div>
        </div>
      </div>

      <div class="p-4 border-t border-white/5 bg-zinc-950/20 flex flex-col gap-3">
        {/* WhatsApp Button */}
        <a
          href="https://wa.me/51959884398?text=Hola%20Yonatan%2C%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20contactarte%20%F0%9F%91%8B"
          target="_blank"
          rel="noopener noreferrer"
          class="whatsapp-btn group relative flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-white text-sm overflow-hidden transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_24px_rgba(37,211,102,0.5)]"
          style="background: linear-gradient(135deg, #128C7E 0%, #25D366 60%, #075E54 100%); box-shadow: 0 0 12px rgba(37,211,102,0.3);"
        >
          {/* Animated shimmer */}
          <span class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style="background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%); animation: whatsapp-shimmer 1.2s infinite;">
          </span>

          {/* Pulse ring */}
          <span class="absolute left-4 flex h-4 w-4">
            <span class="absolute inline-flex h-full w-full rounded-full bg-white/40 animate-ping opacity-75"></span>
          </span>

          {/* WhatsApp icon */}
          <svg
            class="relative z-10 ml-0.5 shrink-0 drop-shadow-sm"
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>

          <span class="relative z-10 flex flex-col leading-tight">
            <span class="text-[11px] font-black tracking-wide uppercase">WhatsApp</span>
            <span class="text-[9px] text-white/80 font-normal">Contáctame ahora</span>
          </span>

          {/* Arrow */}
          <svg class="relative z-10 ml-auto shrink-0 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <AI_AssistantButton client:only="preact" transition:persist />
      </div>
    </aside>
    <FloatingActionChat client:only="preact" transition:persist />
    <ProtostarOverlay
      client:only="preact"
      transition:persist
      STORAGE_CDN_URL={env.STORAGE_CDN_URL}
    />
    <NatureOverlay
      client:only="preact"
      transition:persist
      STORAGE_CDN_URL={env.STORAGE_CDN_URL}
    />
    <PlanetOverlay
      client:only="preact"
      transition:persist
      STORAGE_CDN_URL={env.STORAGE_CDN_URL}
    />
  </body>
</html>
